# Copy this file to .env and adjust for your XAMPP / local MySQL.

NK_APP_ENV=local
NK_APP_KEY=change-this-to-a-long-random-string
NK_FORCE_HTTPS=false

# Typical XAMPP defaults: host 127.0.0.1, user root, empty password.
NK_DB_HOST=127.0.0.1
NK_DB_PORT=3306
NK_DB_NAME=nano_kids_wholesale
NK_DB_USER=root
NK_DB_PASS=

# Optional. Only needed to run setup.php when NK_APP_ENV=production (16+ characters).
# NK_SETUP_TOKEN=
